# Gnani API key from https://app.gnani.ai/voice (shared team credits)
GNANI_API_KEY=
# Groq key from https://console.groq.com/keys (each person makes their own)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# LLM for the live conversation: groq | evon
LLM_PROVIDER=groq
# LLM for intel extraction / reports / triage: groq | evon
INTEL_LLM_PROVIDER=groq
# Evon v3.3 self-hosted OpenAI-compatible endpoint (see docs/EVON-HOSTING.md)
EVON_BASE_URL=
EVON_API_KEY=
EVON_MODEL=gnani-evon
# STT mode: stream (Prisma realtime WebSocket) | turn (local VAD + REST, fallback)
STT_MODE=stream
