  "components": {
    "schemas": {
      "BroadcastIn": {
        "properties": {
          "text_en": {
            "type": "string",
            "title": "Text En"
          },
          "langs": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Langs",
            "default": [
              "ta-IN",
              "hi-IN",
              "te-IN",
              "en-IN",
              "ml-IN",
              "kn-IN",
              "bn-IN"
            ]
          }
        },
        "type": "object",
        "required": [
          "text_en"
        ],
        "title": "BroadcastIn"
      },
      "CapIn": {
        "properties": {
          "text_en": {
            "type": "string",
            "title": "Text En"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/CapItem"
            },
            "type": "array",
            "title": "Items"
          },
          "area": {
            "type": "string",
            "title": "Area",
            "default": "Chennai"
          }
        },
        "type": "object",
        "required": [
          "text_en",
          "items"
        ],
        "title": "CapIn"
      },
      "CapItem": {
        "properties": {
          "lang": {
            "type": "string",
            "title": "Lang"
          },
          "text": {
            "type": "string",
            "title": "Text"
          }
        },
        "type": "object",
        "required": [
          "lang",
          "text"
        ],
        "title": "CapItem"
      },
      "DispatchIn": {
        "properties": {
          "team": {
            "type": "string",
            "title": "Team"
          },
          "note": {
            "type": "string",
            "title": "Note",
            "default": ""
          },
          "eta": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Eta"
          }
        },
        "type": "object",
        "required": [
          "team"
        ],
        "title": "DispatchIn"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "MessageIn": {
        "properties": {
          "text": {
            "type": "string",
            "title": "Text"
          }
        },
        "type": "object",
        "required": [
          "text"
        ],
        "title": "MessageIn"
      },
      "MissedCallIn": {
        "properties": {
          "gps": {
            "anyOf": [
              {
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "type": "array",
                "maxItems": 2,
                "minItems": 2
              },
              {
                "type": "null"
              }
            ],
            "title": "Gps"
          }
        },
        "type": "object",
        "title": "MissedCallIn"
      },
      "SmsIn": {
        "properties": {
          "text": {
            "type": "string",
            "title": "Text"
          },
          "gps": {
            "anyOf": [
              {
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "type": "array",
                "maxItems": 2,
                "minItems": 2
              },
              {
                "type": "null"
              }
            ],
            "title": "Gps"
          }
        },
        "type": "object",
        "required": [
          "text"
        ],
        "title": "SmsIn"
      },
      "SurgeIn": {
        "properties": {
          "n": {
            "type": "integer",
            "title": "N",
            "default": 20
          },
          "fresh": {
            "type": "boolean",
            "title": "Fresh",
            "default": false
          }
        },
        "type": "object",
        "title": "SurgeIn"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
